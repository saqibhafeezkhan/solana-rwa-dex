{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "dev": "bun run build:sdk && bunx vite",
    "build": "bun run build:sdk && bunx tsc -b && bunx vite build",
    "lint": "bunx oxlint .",
    "test": "bun test",
    "knip": "knip",
    "pdas": "bun run examples/pdas.ts",
    "typecheck:sdk": "bunx tsc -p sdk/tsconfig.json",
    "build:sdk": "cd sdk && bun run build",
    "smoke:localnet": "bun run scripts/smoke-localnet.ts",
    "preview": "bunx vite preview",
    "bootstrap:localnet": "bash scripts/bootstrap-localnet.sh",
    "deploy:localnet": "bash ../../scripts/deploy-localnet.sh",
    "seed:localnet": "bun run scripts/seed-localnet.ts",
    "test:anchor": "cd ../../tests && bun run test",
    "commitlint": "commitlint --edit",
    "fix:hooks": "bun run scripts/fix-git-hooks.ts",
    "prepare": "lefthook install && bun run fix:hooks"
  },
  "dependencies": {
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.8.0",
    "@rwa-dex/sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bs58": "^4.0.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.44.0",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
