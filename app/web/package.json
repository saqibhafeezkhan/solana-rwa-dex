{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx tsc -b && bunx vite build",
    "lint": "bunx oxlint .",
    "preview": "bunx vite preview",
    "bootstrap:localnet": "bash scripts/bootstrap-localnet.sh",
    "deploy:localnet": "bash ../../scripts/deploy-localnet.sh",
    "seed:localnet": "bun run scripts/seed-localnet.ts",
    "test:anchor": "cd ../../tests && bun run test",
    "commitlint": "commitlint --edit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.8.0",
    "@solana/kit": "^8.1.0",
    "@solana/kit-plugin-litesvm": "^0.18.0",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
